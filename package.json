{
  "name": "mayday-hackathon-fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "vite build",
    "preview": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run test && npm run build && node scripts/smoke.mjs",
    "ai:check": "node scripts/check-claude.mjs",
    "backend:check": "node scripts/check-team5.mjs",
