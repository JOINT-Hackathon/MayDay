# Claude Console에서 발급한 API 키를 .env에만 입력하세요.
# https://platform.claude.com/settings/keys
# 비워 두면 기본 정리·직접 입력·시연 예시가 동작합니다.
# VITE_ 접두사를 붙이지 마세요. 브라우저에 키가 노출됩니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 특정 workspace에 묶이지 않은 키만 필요합니다. workspace 지정 키라면 비워 두세요.
ANTHROPIC_WORKSPACE_ID=
# 프로세스당 하루 호출 시도 한도. 결제 금액 한도가 아니며 재시작 시 초기화됩니다.
AI_DAILY_LIMIT=100
# 키 입력·모델 변경 후 서버를 재시작하고 npm run ai:check를 실행하세요.
# HOST=127.0.0.1
# PORT=4173

# TEAM5 Spring 백엔드 origin (경로 없이 입력). 기본값은 로컬 8080입니다.
TEAM5_BACKEND_URL=http://127.0.0.1:8080

# 영구 DB는 backend:start가 프로젝트 data/mayday로 지정합니다.
# BACKEND_PORT=8080
# MAYDAY_DB_URL=jdbc:h2:file:/absolute/persistent/path/mayday;MODE=MySQL;DB_CLOSE_ON_EXIT=FALSE
# MAYDAY_DB_USER=sa
# MAYDAY_DB_PASSWORD=
# HTTPS 배포에서 true로 설정하세요. 로컬 HTTP는 false입니다.
COOKIE_SECURE=false

# Cloud Docker requires PostgreSQL; keep real credentials only in hosting secrets.
# MAYDAY_DB_URL=jdbc:postgresql://host:5432/database
# MAYDAY_DB_USER=
# MAYDAY_DB_PASSWORD=
# MAYDAY_DB_SCHEMA=schema-postgresql.sql
